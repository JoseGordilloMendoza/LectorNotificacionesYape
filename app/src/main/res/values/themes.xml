<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.KAJAapp" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/kaja_teal</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryVariant">@color/kaja_teal_dark</item>
        <item name="colorSecondary">@color/kaja_coral</item>
        <item name="colorSecondaryVariant">@color/kaja_gold</item>
        <!-- Tipografía global amigable -->
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="Theme.KAJAapp" parent="Base.Theme.KAJAapp" />

    <!-- Toolbar con fondo morado y texto/iconos blancos -->
    <style name="ToolbarTheme" parent="ThemeOverlay.MaterialComponents.Dark.ActionBar">
        <item name="android:textColorPrimary">#FFFFFF</item>
        <item name="android:textColorSecondary">#FFFFFF</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="colorControlNormal">#FFFFFF</item>
    </style>

</resources>