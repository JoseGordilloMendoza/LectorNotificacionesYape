<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    app:cardCornerRadius="14dp"
    app:cardElevation="1dp"
    app:cardBackgroundColor="@color/white"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:paddingVertical="14dp">

        <!-- Wallet icon circle -->
        <ImageView
            android:id="@+id/ivWalletIcon"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/circle_indicator"
            android:backgroundTint="@color/kaja_teal"
            android:padding="10dp"
            android:src="@drawable/ic_person"
            app:tint="@color/white"
            android:contentDescription="Wallet"/>

        <!-- Sender name + time + wallet type -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="14dp">

            <TextView
                android:id="@+id/tvSenderName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nombre del Cliente"
                android:textStyle="bold"
                android:textSize="15sp"
                android:textColor="@color/kaja_teal_dark"
                android:maxLines="1"
                android:ellipsize="end"/>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="3dp">

                <TextView
                    android:id="@+id/tvTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="14:30"
                    android:textSize="12sp"
                    android:textColor="@color/kaja_blue_pale"/>

                <View
                    android:layout_width="3dp"
                    android:layout_height="3dp"
                    android:background="@drawable/circle_indicator"
                    android:backgroundTint="@color/kaja_blue_pale"
                    android:layout_marginStart="6dp"
                    android:layout_marginEnd="6dp"/>

                <TextView
                    android:id="@+id/tvWalletType"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="YAPE"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/kaja_teal"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Amount -->
        <TextView
            android:id="@+id/tvAmount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="+ S/ 0.00"
            android:textStyle="bold"
            android:textSize="18sp"
            android:textColor="@color/kaja_teal_dark"
            android:layout_marginStart="12dp"/>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
