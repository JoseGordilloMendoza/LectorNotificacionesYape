<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="32dp"
    android:background="@color/white">

    <!-- Logo/Icono -->
    <ImageView
        android:layout_width="600dp"
        android:layout_height="wrap_content"
        android:adjustViewBounds="true"
        android:scaleType="fitCenter"
        android:src="@drawable/kaja"
        android:layout_marginBottom="24dp"
        android:contentDescription="Logo KAJA"/>

    <!-- Título -->
    

    <!-- Subtítulo con letterSpacing (idea #5) -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="SINCRONIZA TUS REGISTROS"
        android:textSize="12sp"
        android:textColor="@color/kaja_blue_pale"
        android:gravity="center"
        android:letterSpacing="0.15"
        android:layout_marginBottom="32dp"/>

    <!-- Descripción -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Inicia sesión con tu cuenta de Google para comenzar."
        android:textSize="15sp"
        android:textColor="@color/kaja_teal_dark"
        android:gravity="center"
        android:layout_marginBottom="32dp"
        android:lineSpacingExtra="4dp"/>

    <!-- Separador de circuito KAJA (idea #2) -->
    <View
        android:layout_width="match_parent"
        android:layout_height="12dp"
        android:background="@drawable/divider_circuit"
        android:layout_marginBottom="24dp"/>

    <!-- Botón de Google Sign-In con gradiente diagonal (idea #6) -->
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnGoogleSignIn"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="INICIAR SESIÓN CON GOOGLE"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:letterSpacing="0.05"
        android:background="@drawable/bg_pill_gradient"
        android:translationZ="4dp"
        android:paddingStart="24dp"
        android:paddingEnd="24dp" />

    <!-- Nota de privacidad -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Al continuar, aceptas la sincronización segura de las alertas bancarias entrantes."
        android:textSize="12sp"
        android:textColor="@color/kaja_teal"
        android:gravity="center"
        android:layout_marginTop="24dp"
        android:lineSpacingExtra="2dp"/>

    <!-- Estado de carga -->
    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:indeterminateTint="@color/kaja_coral"
        android:visibility="gone"/>

    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Iniciando sesión..."
        android:textSize="14sp"
        android:textColor="@color/kaja_teal_dark"
        android:layout_marginTop="16dp"
        android:visibility="gone"/>

</LinearLayout>
