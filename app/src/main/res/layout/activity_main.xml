<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/kaja_bg_light">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:layout_alignParentTop="true"
        android:background="@color/white"
        android:elevation="4dp"
        android:theme="@style/ThemeOverlay.AppCompat.Light"
        app:title="">

        <!-- Contenido custom del toolbar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="4dp"
            android:paddingEnd="16dp">

            <!-- Logo KAJA pequeño -->
            <ImageView
                android:layout_width="72dp"
                android:layout_height="wrap_content"
                android:adjustViewBounds="true"
                android:scaleType="fitCenter"
                android:src="@drawable/kaja"
                android:contentDescription="KAJA"/>

            <!-- Separador vertical fino -->
            <View
                android:layout_width="1dp"
                android:layout_height="20dp"
                android:background="@color/kaja_pink_pale"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"/>

            <!-- Título de la pestaña en negrita -->
            <TextView
                android:id="@+id/tvToolbarTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="INICIO"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/kaja_teal_dark"
                android:letterSpacing="0.08"/>

        </LinearLayout>

    </com.google.android.material.appbar.MaterialToolbar>

    <FrameLayout
        android:id="@+id/screensContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/toolbar"
        android:layout_above="@+id/bottomNavigation">

        <!-- CONTENEDOR 1: HOME -->
        <ScrollView
            android:id="@+id/containerHome"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp"
                android:clipToPadding="false"
                android:gravity="center_horizontal">

                <!-- HERO TEXT & COUNTER -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_hero_polygon"
                    android:orientation="vertical"
                    android:padding="32dp"
                    android:gravity="center"
                    android:elevation="8dp"
                    android:layout_marginBottom="24dp">

                    <TextView
                        android:id="@+id/tvTransactionSum"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="S/ 0.00"
                        android:textSize="50sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF" />

                    <TextView
                        android:id="@+id/tvTransactionCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0 TRANSACCIONES DE HOY"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="@color/kaja_gold"
                        android:letterSpacing="0.15"
                        android:layout_marginTop="4dp" />

                    <!-- Contador total histórico de la cuenta -->
                    <TextView
                        android:id="@+id/tvTransactionTotalCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Histórico: 0 Transacciones en la nube"
                        android:textSize="12sp"
                        android:textColor="@color/white"
                        android:alpha="0.8"
                        android:layout_marginTop="2dp" />
                </LinearLayout>

                <!-- Separador de circuito KAJA (idea #2) -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="12dp"
                    android:background="@drawable/divider_circuit"
                    android:layout_marginBottom="20dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="El servicio de lectura escuchará automáticamente."
                    android:textSize="14sp"
                    android:textColor="@color/kaja_teal_dark"
                    android:layout_marginBottom="24dp"
                    android:gravity="center"/>

                <!-- SERVICE STATUS -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_dark_card"
                    android:orientation="vertical"
                    android:padding="20dp"
                    android:elevation="2dp"
                    android:layout_marginBottom="24dp">

                    <!-- Título con letterSpacing (idea #5) -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ESTADO DEL SERVICIO"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:textColor="@color/kaja_blue_pale"
                        android:letterSpacing="0.15"
                        android:layout_marginBottom="12dp"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <View
                            android:id="@+id/statusIndicator"
                            android:layout_width="12dp"
                            android:layout_height="12dp"
                            android:background="@drawable/circle_indicator"
                            android:backgroundTint="@color/kaja_coral"
                            android:layout_marginEnd="12dp"/>

                        <TextView
                            android:id="@+id/tvPermissionStatus"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Servicio Inactivo"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:textColor="@color/kaja_teal_dark"/>

                    </LinearLayout>

                    <!-- Separador de circuito KAJA (idea #2) -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="12dp"
                        android:background="@drawable/divider_circuit"
                        android:layout_marginTop="16dp"
                        android:layout_marginBottom="16dp"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Escucha Background"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:textColor="@color/kaja_teal_dark"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Mantener activo el hilo principal"
                                android:textSize="12sp"
                                android:textColor="@color/kaja_teal"
                                android:layout_marginTop="2dp"/>
                        </LinearLayout>

                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/switchPersistentNotification"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="false" />
                    </LinearLayout>

                </LinearLayout>

                <!-- ENABLE PERMISSION BUTTON (idea #6: gradiente diagonal) -->
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnEnableNotifications"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="HABILITAR ACCESO"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_pill_gradient"
                    android:textColor="@color/white"
                    android:letterSpacing="0.08"
                    android:translationZ="4dp"
                    android:layout_marginBottom="24dp"/>

                <!-- XIAOMI RESTRICTED WARNING -->
                <LinearLayout
                    android:id="@+id/cardRestrictedSettings"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_dark_card"
                    android:backgroundTint="@color/kaja_pink_pale"
                    android:orientation="vertical"
                    android:padding="20dp"
                    android:layout_marginBottom="24dp">

                <!-- Cruz KAJA (idea #3) como bullet de warning Xiaomi -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:src="@drawable/ic_kaja_cross"
                        android:layout_marginEnd="10dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ACCESO RESTRINGIDO"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="@color/kaja_coral"
                        android:letterSpacing="0.12"/>
                </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="1. Ve a Info. de la App\n2. Toca los 3 puntos arriba a la derecha\n3. Permitir ajustes restringidos\n4. Vuelve e intenta de nuevo"
                        android:textSize="13sp"
                        android:textColor="@color/kaja_teal_dark"
                        android:lineSpacingExtra="4dp"
                        android:layout_marginBottom="16dp"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnOpenAppInfo"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:text="Ir a Info. de la App"
                        android:textColor="@color/kaja_coral"
                        app:strokeColor="@color/kaja_coral"
                        app:cornerRadius="16dp"/>

                </LinearLayout>

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnOpenWeb"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="Ver en el Portal Web"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_pill_teal"
                    android:textColor="@color/white"
                    android:translationZ="4dp"
                    android:layout_marginBottom="16dp"/>

                <!-- UPDATE BANNER -->
                <LinearLayout
                    android:id="@+id/cardUpdateBanner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_dark_card"
                    android:backgroundTint="@color/white"
                    android:orientation="vertical"
                    android:padding="20dp"
                    android:elevation="4dp"
                    android:visibility="gone"
                    android:layout_marginBottom="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Aviso"
                            android:textSize="22sp"
                            android:textColor="@color/kaja_gold"
                            android:textStyle="bold"
                            android:layout_marginEnd="12dp"/>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Nueva versión"
                                android:textSize="15sp"
                                android:textStyle="bold"
                                android:textColor="@color/kaja_teal_dark"/>

                            <TextView
                                android:id="@+id/tvUpdateVersion"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="v?.?.?"
                                android:textSize="12sp"
                                android:textColor="@color/kaja_teal" />
                        </LinearLayout>

                    </LinearLayout>

                    <!-- Separador de circuito KAJA (idea #2) -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="12dp"
                        android:background="@drawable/divider_circuit"
                        android:layout_marginBottom="16dp"/>

                    <!-- Título con letterSpacing (idea #5) -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="NUEVA VERSIÓN DISPONIBLE"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:textColor="@color/kaja_blue_pale"
                        android:letterSpacing="0.15"
                        android:layout_marginBottom="8dp"/>

                    <TextView
                        android:id="@+id/tvUpdateReleaseNotes"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Mejoras introducidas"
                        android:textSize="13sp"
                        android:textColor="@color/kaja_teal_dark"
                        android:layout_marginBottom="16dp"/>

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btnInstallUpdate"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:text="INSTALAR AHORA"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"
                        android:letterSpacing="0.08"
                        android:background="@drawable/bg_pill_gradient" />
                </LinearLayout>

            </LinearLayout>
        </ScrollView>

        <!-- CONTENEDOR 2: UPDATES -->
        <ScrollView
            android:id="@+id/containerUpdates"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:visibility="gone">
            <include layout="@layout/dialog_updates" />
        </ScrollView>

        <!-- CONTENEDOR 3: PROFILE -->
        <ScrollView
            android:id="@+id/containerProfile"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:visibility="gone">
            <include layout="@layout/dialog_profile" />
        </ScrollView>

    </FrameLayout>

    <!-- BARRA NAVEGACIÓN INFERIOR -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="@color/white"
        android:elevation="8dp"
        app:itemIconTint="@color/kaja_teal"
        app:itemTextColor="@color/kaja_teal_dark"
        app:menu="@menu/bottom_nav_menu" />

</RelativeLayout>
