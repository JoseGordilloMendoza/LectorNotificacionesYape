<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/kaja_bg_light"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="JORNADA DEL AYUDANTE"
            android:textColor="@color/kaja_blue_pale"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvShiftMemberName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Marco Salas"
            android:textColor="@color/kaja_teal_dark"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvShiftActiveStall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Puesto activo: Puesto 2"
            android:textColor="@color/kaja_teal"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/tvShiftStarted"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Iniciaste jornada a las 07:30"
            android:textColor="@color/kaja_teal_dark"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvShiftWindow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Turno manana - demo"
            android:textColor="@color/kaja_teal"
            android:textSize="13sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:layout_marginBottom="12dp"
            android:text="ELIGE TU PUESTO ACTIVO"
            android:textColor="@color/kaja_teal_dark"
            android:textSize="12sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/layoutShiftButtons"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </LinearLayout>

</ScrollView>
