<?xml version="1.0" encoding="utf-8"?>
<!-- Idea #1: Gradiente diagonal inspirado en los polígonos del logo KAJA (Coral → Teal) -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="135"
        android:startColor="#EF6A62"
        android:centerColor="#1A7F7C"
        android:endColor="#125957"
        android:type="linear"/>
    <corners android:radius="24dp"/>
</shape>
