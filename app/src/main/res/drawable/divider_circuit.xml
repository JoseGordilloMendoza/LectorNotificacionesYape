<?xml version="1.0" encoding="utf-8"?>
<!-- Idea #2: Separador inspirado en el ornamento de circuito PCB del logo KAJA -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Línea izquierda -->
    <item
        android:left="0dp"
        android:right="46dp"
        android:top="5dp"
        android:bottom="5dp">
        <shape android:shape="line">
            <stroke
                android:width="1dp"
                android:color="#1A7F7C"/>
        </shape>
    </item>
    <!-- Nodo central -->
    <item
        android:left="44dp"
        android:right="44dp"
        android:gravity="center">
        <shape android:shape="oval">
            <solid android:color="#EF6A62"/>
            <size android:width="8dp" android:height="8dp"/>
        </shape>
    </item>
    <!-- Línea derecha -->
    <item
        android:left="46dp"
        android:right="0dp"
        android:top="5dp"
        android:bottom="5dp">
        <shape android:shape="line">
            <stroke
                android:width="1dp"
                android:color="#1A7F7C"/>
        </shape>
    </item>
</layer-list>
